{
  "name": "ecommerce-fullstack-design",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack eCommerce app with React, Express, and MongoDB.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "seed": "npm --workspace server run seed",
    "check:assets": "node scripts/check-assets.js",
    "build": "npm --workspace client run build",
    "build:all": "npm run build",
    "preview": "npm --workspace client run preview",
    "start": "npm --workspace server start",
    "start:prod": "npm --workspace server start"
  },
  "keywords": [
    "ecommerce",
    "react",
    "express"
  ],
  "author": "",
  "license": "MIT"
}
